    "express-rate-limit": "^8.2.1",
    "googleapis": "^171.4.0",
    "open": "^11.0.0",
    "playwright": "^1.58.2",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "typescript": "^5.7.0"
